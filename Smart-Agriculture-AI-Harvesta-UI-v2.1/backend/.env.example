# ============================================================
# Smart Agriculture AI Platform - Backend Environment Template
# Copy to backend/.env and fill in real values. NEVER commit
# backend/.env or any file containing real secrets.
# ============================================================

# --- Database ---
# LOCAL DEVELOPMENT (default): leave unset/empty to use SQLite at data/smart_agriculture.db
# PRODUCTION (Supabase PostgreSQL): use the project pooler URL with SSL, e.g.
# DATABASE_URL=postgresql://user:password@pooler-host:6543/postgres?sslmode=require
DATABASE_URL=

# --- Security / JWT ---
# REQUIRED in production. Generate a strong value with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# --- Gmail SMTP Email Verification ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_DELIVERY_ENABLED=true
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com

# --- Frontend URL ---
# Public URL of the deployed frontend (verification email links point here).
FRONTEND_URL=http://localhost:5173

# --- CORS (optional) ---
# Extra allowed origins, comma-separated. FRONTEND_URL is always included.
# CORS_EXTRA_ORIGINS=https://your-custom-domain.com

# --- Local-first AI Chat (Ollama) ---
# auto: use Ollama when available, otherwise built-in offline agriculture guidance
# ollama: prefer Ollama but still fail safely to offline guidance
# offline: never call a local model server
LOCAL_AI_MODE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=90
# Interactive chat falls back to concise built-in guidance after this deadline.
# Database/network time is additional; this does not limit other model tasks.
CHAT_MODEL_TIMEOUT_SECONDS=6
DISEASE_MIN_ACTION_CONFIDENCE=0.65

# --- Private Supabase Storage for crop disease photos ---
# Create a private bucket named crop-disease-scans. Keep the secret key
# on the backend only; never expose it through VITE_* variables or mobile code.
SUPABASE_STORAGE_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_backend_only_sb_secret_key
# Legacy fallback for older Supabase projects only:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_backend_only_service_role_key
SUPABASE_STORAGE_BUCKET=crop-disease-scans
SUPABASE_STORAGE_REQUIRED=false
# Optional local fallback override. Leave unset for data/uploads/disease_scans.
# DISEASE_UPLOAD_DIR=C:/path/to/private/uploads

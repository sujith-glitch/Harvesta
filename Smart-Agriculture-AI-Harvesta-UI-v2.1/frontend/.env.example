# Smart Agriculture AI Platform — Frontend Environment Template
# Copy this file to frontend/.env for local development.
# For production deployments (Render, Vercel, Netlify), set these as
# environment variables in the hosting dashboard instead.
#
# ─────────────────────────────────────────────────────────────
# BACKEND API URL
# ─────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT:
#   Leave unset — Vite proxies /api to the local backend on port 8000.
#   This also supports phone testing with a trusted HTTPS certificate.
#   For a same-origin HTTPS deployment, configure /api on the hosting proxy.
#
# PRODUCTION:
#   Set to the public URL of your deployed Render backend, e.g.:
#   VITE_API_BASE_URL=https://smart-agriculture-api.onrender.com
VITE_API_BASE_URL=

# OPTIONAL LOCAL HTTPS: certificate must be trusted by your phone and match
# the hostname/IP used to open the site. These paths are server-only, not VITE_*.
# See docs/PHONE-VOICE-CHAT.md. Do not bypass certificate/browser warnings.
HARVESTA_HTTPS_CERT=
HARVESTA_HTTPS_KEY=

# ─────────────────────────────────────────────────────────────
# DEMO MODE (OPTIONAL — DEVELOPMENT ONLY)
# ─────────────────────────────────────────────────────────────
# Controls whether the "Test Login (Demo Mode)" button is visible
# on the login screen and whether the frontend can bypass JWT auth.
#
# PRODUCTION: MUST be absent, unset, or set to false.
#   When unset, demo mode is fully disabled — this is the safe default.
#
# LOCAL / DEMO DEVELOPMENT ONLY:
#   VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_DEMO_MODE=
